# Copy to .env and fill in. The container reads its environment from compose;
# .env is for running the binary on a laptop, and is gitignored.

# --- printer (required) ---------------------------------------------------
# The access code is on the printer's screen under Settings → WLAN. It is also
# the MQTT and RTSPS password, and it does not rotate while LAN Only Liveview
# is on.
PRINTER_HOST=192.168.1.110
PRINTER_SERIAL=00M00A000000000
PRINTER_ACCESS_CODE=

# Operator alias used in the posted filename. Never the serial: that is the
# MQTT topic key and the cloud-binding identifier, and the filename is
# published to a channel.
PRINTER_NAME=p2s-01

# --- destination (required by the service, not by `record` or `debug`) -----
MEDIA_API_URL=
MEDIA_API_TOKEN=
# Extra form fields, posted verbatim. Whatever the consumer needs to route the
# result — a chat id, a topic — is configuration, not code.
#MEDIA_API_FIELDS={"chat_id":"-1001234567890","topic_id":"907","silent":"true"}

# --- external binaries -----------------------------------------------------
# Plain names resolve through PATH, which is what the container relies on. Set
# an absolute path when the caller has its own idea of PATH — an IDE run
# configuration, a cron entry, a unit file. On nix:
#   nix build --no-link --print-out-paths nixpkgs#ffmpeg
#FFMPEG_BIN=ffmpeg
#FFPROBE_BIN=ffprobe

# --- capture ---------------------------------------------------------------
#STAGING_DIR=./staging
#TIMELAPSE_FPS=20
# Seconds to wait after a layer change before grabbing. At the instant
# layer_num increments the toolhead is mid-Z-hop and usually dead centre.
#CAPTURE_DELAY=2
# ffmpeg crop w:h:x:y, applied to the video and the cover. The gantry sits in
# a fixed band at the top of frame; this keeps everything below it.
#CROP=1920:820:0:260
# Below this many frames the job is discarded rather than posted. Lower it if
# you print small parts.
#MIN_FRAMES=30
#FINAL_FRAME_DELAY=45
#MIN_FREE_MB=2048
#FAILED_TTL_DAYS=7

# --- overlay and held ends -------------------------------------------------
#OVERLAY=true
# Path to a font. Empty uses the one compiled into the binary.
#OVERLAY_FONT=
# Seconds the slicer's plate render is held at the head, and the finished
# print at the end.
#INTRO_HOLD=2
#TAIL_HOLD=2
# How long to wait for the preview fetch over FTPS. It runs while the print
# does, so nothing is waiting on it.
#PREVIEW_TIMEOUT=20

# --- service ---------------------------------------------------------------
#LISTEN_ADDR=:8092
#LOG_LEVEL=info
